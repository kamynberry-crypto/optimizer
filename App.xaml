<Application x:Class="PulseForge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#070B12"/>
        <SolidColorBrush x:Key="Panel" Color="#0D1420"/>
        <SolidColorBrush x:Key="Panel2" Color="#111B2A"/>
        <SolidColorBrush x:Key="Line" Color="#203044"/>
        <SolidColorBrush x:Key="Text" Color="#F3F7FF"/>
        <SolidColorBrush x:Key="Muted" Color="#8290A6"/>
        <SolidColorBrush x:Key="Accent" Color="#39D5FF"/>
        <SolidColorBrush x:Key="Accent2" Color="#7B61FF"/>
        <SolidColorBrush x:Key="Good" Color="#38E6A5"/>
        <SolidColorBrush x:Key="Warn" Color="#FFCA67"/>
    </Application.Resources>
</Application>
